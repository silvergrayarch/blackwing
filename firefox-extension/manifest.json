{
  "manifest_version": 2,
  "name": "Blackwing",
  "version": "1.0.0",
  "description": "Twitch streamer discovery tool",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "https://*.twitch.tv/*",
    "https://k.twitchcdn.net/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "browser_action": {
    "default_title": "Blackwing",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "blackwing@silverfiles.cc"
    }
  }
}